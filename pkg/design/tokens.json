{
  "font": {
    "text": "\"Red Hat Text\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "display": "Geist, \"Red Hat Text\", system-ui, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
  },
  "type": {
    "large-title": [28, 34, 600, -0.02],
    "title-1": [22, 28, 600, -0.015],
    "title-2": [18, 24, 600, -0.01],
    "title-3": [16, 22, 600, -0.005],
    "headline": [14, 20, 600, 0],
    "body-large": [15, 22, 400, 0],
    "body": [14, 20, 400, 0],
    "callout": [13, 18, 400, 0],
    "subheadline": [12, 16, 400, 0],
    "footnote": [11, 14, 400, 0.005],
    "caption": [11, 14, 600, 0.01],
    "mono": [13, 20, 400, 0]
  },
  "space": [0, 2, 4, 6, 8, 10, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": {
    "4": 4,
    "6": 6,
    "8": 8,
    "10": 10,
    "12": 12,
    "16": 16,
    "18": 18,
    "26": 26,
    "full": 9999
  },
  "shape": {
    "window": 26,
    "panel": 18,
    "card": 12,
    "row": 8,
    "field": 8,
    "small": 4
  },
  "control": {
    "sm": 24,
    "md": 28,
    "lg": 36,
    "xl": 44
  },
  "icon": {
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24
  },
  "duration": {
    "instant": 80,
    "fast": 150,
    "base": 250,
    "slow": 350,
    "sheet": 450
  },
  "ease": {
    "standard": [0.25, 0.1, 0.25, 1],
    "out": [0.16, 1, 0.3, 1],
    "in": [0.4, 0, 1, 1],
    "in-out": [0.65, 0, 0.35, 1],
    "spring": {"damping": 0.82, "response": 0.42},
    "spring-bouncy": {"damping": 0.62, "response": 0.5}
  },
  "frosted": {
    "blur": 24,
    "saturate": 1.6
  },
  "z": {
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "popover": 1000,
    "overlay": 2000,
    "sheet": 2100,
    "tooltip": 3000
  },
  "focus": {
    "width": 3,
    "offset": 0,
    "soft-width": 3
  },
  "color": {
    "bg": {"light": "#F8F8F5", "dark": "#040607", "darkContrast": "#101A1D", "note": "window / canvas (paper; dark is the TUI background)"},
    "surface": {"light": "#FFFFFF", "dark": "#090D0E", "darkContrast": "#172428", "note": "content, cards, fields"},
    "surface-2": {"light": "#EEF1F0", "dark": "#0F1416", "darkContrast": "#1E2F34", "note": "grouped rows, sidebar panel, received bubble on bg"},
    "surface-3": {"light": "#E4E9E7", "dark": "#161D1F", "darkContrast": "#26393F", "note": "inputs on surface-2, pressed rows"},
    "fill": {"light": "rgba(23,36,40,.07)", "dark": "rgba(248,248,245,.10)", "lightContrast": "rgba(23,36,40,.12)", "darkContrast": "rgba(248,248,245,.16)", "note": "gray control fill (bordered button, track)"},
    "fill-hover": {"light": "rgba(23,36,40,.10)", "dark": "rgba(248,248,245,.14)"},
    "fill-pressed": {"light": "rgba(23,36,40,.15)", "dark": "rgba(248,248,245,.20)"},
    "text": {"light": "#172428", "dark": "#F8F8F5"},
    "text-2": {"light": "#65757A", "dark": "#8B9CA1", "lightContrast": "#3F4E52", "darkContrast": "#C3CED1", "note": "secondary"},
    "text-3": {"light": "#8E9CA0", "dark": "#637478", "lightContrast": "#5C6B70", "darkContrast": "#9AABB0", "note": "tertiary: placeholders, disabled labels"},
    "text-on-accent": {"light": "#FFFFFF", "dark": "#FFFFFF"},
    "line": {"light": "#DCE1DE", "dark": "#1F2A2D", "lightContrast": "#7E8C90", "darkContrast": "#7E9297", "note": "borders"},
    "separator": {"light": "rgba(23,36,40,.11)", "dark": "rgba(248,248,245,.11)", "lightContrast": "rgba(23,36,40,.45)", "darkContrast": "rgba(248,248,245,.45)", "note": "hairlines between rows"},
    "accent": {"light": "#0087A4", "dark": "#26A9C6", "note": "icons, dots, links, rings, selection marks"},
    "accent-ink": {"light": "#00748E", "dark": "#5CC6DE", "lightContrast": "#005C71", "darkContrast": "#8ADAEB", "note": "accent text on bg/surface (AA)"},
    "accent-fill": {"light": "#0087A4", "dark": "#0B87A3", "lightContrast": "#00748E", "darkContrast": "#00748E", "note": "filled controls with white text: buttons, sent bubble, toggle on"},
    "accent-fill-hover": {"light": "#007A95", "dark": "#1494B0", "lightContrast": "#00677E", "darkContrast": "#00677E"},
    "accent-fill-pressed": {"light": "#006A81", "dark": "#0A788F", "lightContrast": "#005A6E", "darkContrast": "#005A6E"},
    "accent-soft": {"light": "rgba(0,135,164,.12)", "dark": "rgba(38,169,198,.18)", "note": "tinted button, selected pill"},
    "selection": {"light": "#C4E3EA", "dark": "#1C4E5C", "note": "text selection, selected list row (inactive)"},
    "success": {"light": "#0087A4", "dark": "#26A9C6"},
    "success-soft": {"light": "rgba(0,135,164,.12)", "dark": "rgba(38,169,198,.18)"},
    "warning": {"light": "#65757A", "dark": "#8B9CA1", "darkContrast": "#93A3A8", "note": "waiting dot"},
    "danger": {"light": "#D13D3D", "dark": "#F0605D"},
    "danger-fill": {"light": "#D13D3D", "dark": "#C8403E", "note": "behind white text (destructive menu row highlight, filled destructive)"},
    "danger-ink": {"light": "#B83232", "dark": "#F57B78"},
    "danger-soft": {"light": "rgba(209,61,61,.11)", "dark": "rgba(240,96,93,.18)"},
    "status-open": {"light": "#0087A4", "dark": "#26A9C6"},
    "status-waiting": {"light": "#65757A", "dark": "#8B9CA1", "darkContrast": "#93A3A8"},
    "status-closed": {"light": "#A3AEB1", "dark": "#566A70"},
    "bubble-sent": {"light": "#0087A4", "dark": "#0B87A3", "lightContrast": "#00748E", "darkContrast": "#00748E"},
    "bubble-sent-ink": {"light": "#FFFFFF", "dark": "#FFFFFF"},
    "bubble-received": {"light": "#E7ECEA", "dark": "#161D1F", "darkContrast": "#26393F"},
    "bubble-received-ink": {"light": "#172428", "dark": "#F8F8F5"},
    "scrim": {"light": "rgba(16,26,29,.28)", "dark": "rgba(0,0,0,.52)"},
    "focus": {"light": "rgba(0,135,164,.42)", "dark": "rgba(38,169,198,.50)", "lightContrast": "rgba(0,92,113,.9)", "darkContrast": "rgba(138,218,235,.9)", "note": "keyboard focus ring on buttons and controls, hugs the shape (offset 0)"},
    "focus-soft": {"light": "rgba(0,135,164,.34)", "dark": "rgba(38,169,198,.50)", "lightContrast": "rgba(0,92,113,.9)", "darkContrast": "rgba(138,218,235,.9)", "note": "boxed and search fields: soft Apple ring that replaces the edge (below 3:1, as Apple); composers and grouped-row fields: no ring"},
    "floating": {"light": "#F4F5F3", "dark": "#111719", "lightContrast": "#FFFFFF", "darkContrast": "#000000", "note": "menus, popovers, sheets, alerts, toolbars: solid, never translucent"},
    "floating-edge": {"light": "rgba(23,36,40,.10)", "dark": "rgba(248,248,245,.12)", "lightContrast": "rgba(0,0,0,.5)", "darkContrast": "rgba(255,255,255,.55)"},
    "tooltip": {"light": "#172428", "dark": "#111719", "darkContrast": "#1A2428", "note": "ink tag on light; on dark the floating fill with its edge (an ink tag would vanish)"},
    "tooltip-ink": {"light": "#F8F8F5", "dark": "#F8F8F5"},
    "tooltip-edge": {"light": "rgba(23,36,40,0)", "dark": "rgba(248,248,245,.12)"},
    "knob": {"light": "#FFFFFF", "dark": "#E4E7E6", "note": "switch and slider knobs: white, light gray on dark (macOS)"},
    "code-keyword": {"light": "#9A3C74", "dark": "#E592BF", "note": "syntax colors of code blocks"},
    "code-string": {"light": "#3C7A3F", "dark": "#9FCF92"},
    "code-number": {"light": "#9A5F1E", "dark": "#E3B47E"},
    "code-type": {"light": "#5E4FA0", "dark": "#B6A6EC"},
    "frosted": {"light": "rgba(248,248,245,.72)", "dark": "rgba(9,13,14,.70)", "darkContrast": "rgba(23,36,40,.70)", "note": "popover material: backdrop blur + this fill; Reduce Transparency uses floating"},
    "avatar-slate-top": {"light": "#8B9AA0", "dark": "#5C6E75", "note": "project avatar soft gradients (Mainplane Calm)"},
    "avatar-slate-bottom": {"light": "#6B7B82", "dark": "#425259"},
    "avatar-sky-top": {"light": "#499BB0", "dark": "#35879E"},
    "avatar-sky-bottom": {"light": "#2D7B91", "dark": "#21667A"},
    "avatar-indigo-top": {"light": "#7B89B5", "dark": "#6674A3"},
    "avatar-indigo-bottom": {"light": "#5C6A99", "dark": "#495682"},
    "avatar-sage-top": {"light": "#699B80", "dark": "#52856B"},
    "avatar-sage-bottom": {"light": "#4A7D62", "dark": "#39664F"},
    "avatar-ochre-top": {"light": "#C49B54", "dark": "#B38A42"},
    "avatar-ochre-bottom": {"light": "#A37B35", "dark": "#8C6726"},
    "avatar-terracotta-top": {"light": "#C27B5C", "dark": "#B36C4D"},
    "avatar-terracotta-bottom": {"light": "#A15C3F", "dark": "#8C4E34"},
    "avatar-rose-top": {"light": "#B87282", "dark": "#A66070"},
    "avatar-rose-bottom": {"light": "#965262", "dark": "#824352"},
    "avatar-plum-top": {"light": "#967BA8", "dark": "#846996"},
    "avatar-plum-bottom": {"light": "#755B87", "dark": "#654C75"},
    "avatar-rim-top": {"light": "rgba(255,255,255,.22)", "dark": "rgba(255,255,255,.16)", "note": "avatar inner top highlight"},
    "avatar-rim-edge": {"light": "rgba(0,0,0,.06)", "dark": "rgba(255,255,255,.08)", "note": "avatar inner edge"},
    "glass": {"light": "rgba(252,252,250,.66)", "dark": "rgba(42,50,53,.56)", "lightContrast": "#FFFFFF", "darkContrast": "#000000", "note": "controls that float over content (iOS 26 glass: phone bars, the composer): backdrop blur + this fill + the glass edge and shine; lighter than the page on dark so it reads over it"},
    "glass-edge": {"light": "rgba(23,36,40,.12)", "dark": "rgba(248,248,245,.20)", "lightContrast": "rgba(0,0,0,.5)", "darkContrast": "rgba(255,255,255,.55)"},
    "glass-shine": {"light": "rgba(255,255,255,.85)", "dark": "rgba(255,255,255,.10)", "lightContrast": "rgba(255,255,255,0)", "darkContrast": "rgba(255,255,255,0)", "note": "the 1 px light along a glass control's top edge"}
  },
  "shadow": {
    "1": {"light": "0 1px 2px rgba(16,26,29,.10)", "dark": "0 1px 2px rgba(0,0,0,.40)", "note": "controls"},
    "2": {"light": "0 1px 2px rgba(16,26,29,.08), 0 4px 12px rgba(16,26,29,.08)", "dark": "0 1px 2px rgba(0,0,0,.40), 0 4px 12px rgba(0,0,0,.30)", "note": "cards"},
    "3": {"light": "0 2px 6px rgba(16,26,29,.10), 0 10px 28px rgba(16,26,29,.14)", "dark": "0 2px 6px rgba(0,0,0,.40), 0 10px 28px rgba(0,0,0,.45)", "note": "menus, popovers"},
    "knob": {"light": "0 0 0 .5px rgba(0,0,0,.05), 0 .5px 1.5px rgba(0,0,0,.14), 0 1.5px 4px rgba(0,0,0,.08)", "dark": "0 0 0 .5px rgba(0,0,0,.25), 0 .5px 1.5px rgba(0,0,0,.45), 0 1.5px 4px rgba(0,0,0,.3)", "note": "switch and slider knobs"},
    "4": {"light": "0 8px 20px rgba(16,26,29,.14), 0 24px 64px rgba(16,26,29,.20)", "dark": "0 8px 20px rgba(0,0,0,.45), 0 24px 64px rgba(0,0,0,.55)", "note": "sheets, alerts"}
  }
}
